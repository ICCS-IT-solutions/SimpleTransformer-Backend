{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch (external console)",
            "type": "coreclr",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net9.0/SimpleTransformer-Backend.dll",
            "cwd": "${workspaceFolder}",
            "console": "externalTerminal",
            "request": "launch"
        },
        {
            "name": "Launch (internal console)",
            "type": "coreclr",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net9.0/SimpleTransformer-Backend.dll",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "request": "launch"
        },
        {
            "name": "Attach to process",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "Launch AOT",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "build-aot",
            "program": "${workspaceFolder}/bin/Debug/net9.0/win-x64/publish/SimpleTransformer-Backend.exe",
            "cwd": "${workspaceFolder}",
            "console": "externalTerminal"
        }
    ]
}